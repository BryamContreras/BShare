  "implementedChanges": {
    "sdkDetection": "A single cached SDK query is shared by Android permission decisions. Failed queries remain retryable.",
    "storage": {
      "appPrivateDirectories": "No shared-storage permission request; canonical app-owned directories are resolved before classification.",
      "sharedDirectoriesApi24To29": "Legacy storage permission is checked before browsing, mkdir or file reception; WRITE_EXTERNAL_STORAGE applies through API 29 and requestLegacyExternalStorage is enabled for Android 10.",
      "sharedDirectoriesApi30AndLater": "Current all-files access is checked before raw shared-directory operations. Permission grants are not cached.",
      "picker": "Denied access clears stale selection and blocks listing/confirmation; returning from Settings rechecks access without automatically displaying another permission request.",
      "settings": "Changing the receive destination checks access before creating or saving the directory. Unrelated settings do not request storage access.",
      "videoOnlyReceiver": "Camera/screen transport can start without storage access or Downloads creation. Enabling file reception promotes the existing listener instead of creating another server.",
      "revokedAccess": "New queued or incoming file work is rejected and pending decisions are terminalized. Permission checks on old destinations do not disable a newly selected valid destination; an active duplicate ID does not terminalize the original transfer."
    },
    "wifi": {
      "homeDiscovery": "LAN discovery does not require an initial location/SSID permission request.",
      "localHotspotApiBelow26": "Explicitly unsupported by the native local-only hotspot API.",
      "localHotspotApi26To32": "Requires location access.",
      "localHotspotApi33AndLater": "Requires nearby Wi-Fi device access.",
      "connectApi29AndLater": "Location permission is still required for the scan/network-specifier operation; nearby-device permission does not substitute for that requirement.",
      "settingsAndReadiness": "Opening network settings, checking readiness and binding an existing network do not request unrelated dangerous permissions.",
      "denial": "Current OS permission state is re-read before starting native operations; approximate-only location is not treated as a precise grant."
    },
    "notifications": "Runtime notification permission is requested only on API 33 and later.",
    "nativeForegroundService": {
      "fileTransferType": "connectedDevice, with its manifest permission and network prerequisites; camera/microphone and media-projection service types remain separate.",
      "restartPolicy": "The vendored flutter_background service returns START_NOT_STICKY and handles null/unknown start actions by cleanup and stop.",
      "resourceOwnership": "Explicit starts are idempotent. Cleanup releases acquired wake and Wi-Fi locks even if configuration changed.",
      "vendorReconciliation": "On engine attachment, stopOrphanedService stops an old OS service record only when this process has no live service instance. This preserves a real service when another engine attaches.",
      "boundary": "An OS-owned notification may remain while the UID is dead on Samsung. The final fix is intended to reconcile it when the app opens; immediate notification removal during a dead process is not promised."
    }
  },
